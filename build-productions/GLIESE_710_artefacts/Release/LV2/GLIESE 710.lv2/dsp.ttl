		rdf:value 5 ;
	], [
		rdfs:label "All Wide" ;
		rdf:value 6 ;
	], [
		rdfs:label "All Narrow" ;
		rdf:value 7 ;
	], [
		rdfs:label "Odd Wide" ;
		rdf:value 8 ;
	], [
		rdfs:label "Odd Narrow" ;
		rdf:value 9 ;
	], [
		rdfs:label "Res Wide" ;
		rdf:value 10 ;
	], [
		rdfs:label "Res Narrow" ;
		rdf:value 11 ;
	] .

