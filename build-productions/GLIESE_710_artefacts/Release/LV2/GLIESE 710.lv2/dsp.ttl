plug:master_volume
	a lv2:Parameter ;
	rdfs:label "Master Volume" ;
	rdfs:range atom:Float ;
	lv2:default 0.8 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:master_tune
	a lv2:Parameter ;
	rdfs:label "Master Tune" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum -100 ;
	lv2:maximum 100 .

plug:master_octave
	a lv2:Parameter ;
	rdfs:label "Master Octave" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum -3 ;
	lv2:maximum 3 .

plug:master_pan
	a lv2:Parameter ;
	rdfs:label "Master Pan" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum -1 ;
	lv2:maximum 1 .

plug:master_adsr_a
	a lv2:Parameter ;
	rdfs:label "Master Attack" ;
	rdfs:range atom:Float ;
	lv2:default 0.01 ;
	lv2:minimum 0.001 ;
	lv2:maximum 60 .

plug:master_adsr_d
	a lv2:Parameter ;
	rdfs:label "Master Decay" ;
	rdfs:range atom:Float ;
	lv2:default 0.2 ;
	lv2:minimum 0.001 ;
	lv2:maximum 60 .

plug:master_adsr_s
	a lv2:Parameter ;
	rdfs:label "Master Sustain" ;
	rdfs:range atom:Float ;
	lv2:default 0.8 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:master_adsr_r
	a lv2:Parameter ;
	rdfs:label "Master Release" ;
	rdfs:range atom:Float ;
	lv2:default 0.3 ;
	lv2:minimum 0.001 ;
	lv2:maximum 60 .

plug:master_portamento
	a lv2:Parameter ;
	rdfs:label "Portamento Time" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 5 .

plug:master_age
	a lv2:Parameter ;
	rdfs:label "Age" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:master_feedback
	a lv2:Parameter ;
	rdfs:label "Feedback" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 0.95 .

