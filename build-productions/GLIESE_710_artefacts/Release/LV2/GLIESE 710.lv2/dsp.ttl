plug:master_volume
	a lv2:Parameter ;
	rdfs:label "Master Volume" ;
	rdfs:range atom:Float ;
	lv2:default 0.8 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:master_tune
	a lv2:Parameter ;
	rdfs:label "Master Tune" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum -100 ;
	lv2:maximum 100 .

