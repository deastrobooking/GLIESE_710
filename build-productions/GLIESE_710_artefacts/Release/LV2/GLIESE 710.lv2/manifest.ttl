@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix pset:  <http://lv2plug.in/ns/ext/presets#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

<urn:com:gliesestudios:gliese710>
	a lv2:Plugin ;
	lv2:binary <libGLIESE%20710.so> ;
	rdfs:seeAlso <dsp.ttl> .

<urn:com:gliesestudios:gliese710:UI>
	a ui:CocoaUI ;
	lv2:binary <libGLIESE%20710.so> ;
	rdfs:seeAlso <ui.ttl> .

<urn:com:gliesestudios:gliese710:preset1>
	a pset:Preset ;
	lv2:appliesTo <urn:com:gliesestudios:gliese710> ;
	rdfs:label "" ;
	state:state [ <urn:com:gliesestudios:gliese710:Program> "0"^^xsd:int ; ] .

